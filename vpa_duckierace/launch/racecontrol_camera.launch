<launch>
  <arg name="fps" default="15" />
  <arg name="width" default="1280" />
  <arg name="height" default="720" />

  <node name="usb_cam_1" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="/dev/usb_cam_1" />
    <param name="image_width"  value="$(arg width)" />
    <param name="image_height" value="$(arg height)" />
    <param name="pixel_format" value="mjpeg" />
    <param name="camera_frame_id" value="cam1" />
    <param name="io_method" value="mmap" />
    <param name="fps" value="$(arg fps)" />
    <param name="camera_info_url" value="file://$(find vpa_duckierace)/config/camera.yaml" />
  </node>

  <node name="usb_cam_2" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="/dev/usb_cam_2" />
    <param name="image_width"  value="$(arg width)" />
    <param name="image_height" value="$(arg height)" />
    <param name="pixel_format" value="mjpeg" />
    <param name="camera_frame_id" value="cam2" />
    <param name="io_method" value="mmap" />
    <param name="fps" value="$(arg fps)" />
    <param name="camera_info_url" value="file://$(find vpa_duckierace)/config/camera.yaml" />
  </node>
</launch>
